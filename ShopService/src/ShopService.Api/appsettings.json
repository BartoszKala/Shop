{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ShopDb": "",
    "messaging": ""
  },
  "Jwt": {
    "Authority": "",
    "Audience": "shop-api"
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Messaging": {
    "Enabled": true
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 20,
    "MaxAttempts": 10
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
