{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdentityDb": "",
    "messaging": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "shop-api",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14,
    "SigningKey": {
      "Path": "keys/signing-key.pem",
      "PreviousKeyPaths": [],
      "GenerateIfMissing": false
    }
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Sklep"
  },
  "Frontend": {
    "BaseUrl": "",
    "ConfirmEmailPath": "/account/confirm-email",
    "ConfirmEmailChangePath": "/account/confirm-email-change",
    "ResetPasswordPath": "/account/reset-password"
  },
  "Legal": {
    "TermsOfServiceVersion": "2026-11-01",
    "PrivacyPolicyVersion": "2026-11-01"
  },
  "TwoFactor": {
    "AuthenticatorIssuer": "Sklep"
  },
  "PasswordPolicy": {
    "CheckBreachedPasswords": true
  },
  "Messaging": {
    "Enabled": true
  },
  "Outbox": {
    "PollingInterval": "00:00:02",
    "BatchSize": 20,
    "MaxAttempts": 10
  },
  "Retention": {
    "RefreshTokenDays": 30,
    "SecurityEventDays": 365,
    "ProcessedOutboxDays": 7,
    "Interval": "06:00:00"
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindow": "00:01:00"
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Users": []
  }
}
